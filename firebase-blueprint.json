{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "pin": { "type": "string", "description": "Hashed or secret PIN for app access" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Income or expense record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "categoryId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "categoryId", "date", "createdAt"]
    },
    "Category": {
      "title": "Transaction Category",
      "description": "Categories for grouping transactions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense", "both"] }
      },
      "required": ["userId", "name", "icon", "color"]
    },
    "Budget": {
      "title": "Category Budget",
      "description": "Monthly budget limits for categories",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "categoryId": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "categoryId", "amount", "period", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transaction documents"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Category documents"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Budget documents"
    }
  }
}
